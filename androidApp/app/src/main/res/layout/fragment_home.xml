<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chung"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Attendance Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/attendance_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#4A56E2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_today"
                                android:layout_marginEnd="8dp"
                                app:tint="@android:color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Điểm danh"
                                android:textColor="@android:color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@android:color/white"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Week Stats -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@android:drawable/ic_menu_week"
                                android:layout_marginBottom="8dp"
                                app:tint="@android:color/white" />

                            <TextView
                                android:id="@+id/tv_week_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 lần"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tuần này"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="16dp"
                            android:layout_height="1dp"/>

                        <!-- Month Stats -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@android:drawable/ic_menu_my_calendar"
                                android:layout_marginBottom="8dp"
                                app:tint="#FFD700" />

                            <TextView
                                android:id="@+id/tv_month_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 lần"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tháng này"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Daily Words Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mỗi ngày một từ mới"
                    android:textSize="20sp"
                    android:textColor="#1A1A1A"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_total_words"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 từ"
                    android:textSize="14sp"
                    android:textColor="#4A56E2"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Progress -->
            <TextView
                android:id="@+id/tv_learned_words"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã học: 0/10"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp"/>

            <!-- Daily Words RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/daily_words_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp"/>

            <!-- Learn More Button -->
            <Button
                android:id="@+id/learn_more_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Làm mới từ vựng"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#4A56E2"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Detail Card Overlay (Hidden by default) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/detail_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@android:color/white">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="500dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Close Button -->
                <ImageView
                    android:id="@+id/btn_close_detail"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="Close"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#999999" />

                <!-- Image -->
                <ImageView
                    android:id="@+id/detail_image"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:scaleType="centerCrop"
                    android:background="#F0F0F0"
                    android:contentDescription="Word image" />

                <!-- Word and Audio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/detail_word"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="monkey"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <ImageView
                        android:id="@+id/detail_btn_audio"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_lock_silent_mode_off"
                        android:contentDescription="Play audio"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#4CAF50" />
                </LinearLayout>

                <!-- Phonetic -->
                <TextView
                    android:id="@+id/detail_phonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ˈmʌŋki/"
                    android:textSize="18sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp" />

                <!-- Word Type & Topic -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/detail_word_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="noun"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:background="#4CAF50"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/detail_topic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Animals"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:background="#2196F3"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Meaning Vietnamese -->
                <TextView
                    android:id="@+id/detail_meaning_vn_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nghĩa (Tiếng Việt):"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detail_meaning_vn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone" />

                <!-- Meaning English -->
                <TextView
                    android:id="@+id/detail_meaning_en_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nghĩa (Tiếng Anh):"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detail_meaning_en"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</FrameLayout>