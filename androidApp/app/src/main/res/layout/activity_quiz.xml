<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"/>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Question Number -->
            <TextView
                android:id="@+id/tv_question_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Câu 1/10"
                android:textSize="16sp"
                android:textColor="#666666"
                android:layout_marginBottom="16dp"/>

            <!-- Word Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Word Image -->
                    <ImageView
                        android:id="@+id/iv_word_image"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"/>

                    <!-- Word -->
                    <TextView
                        android:id="@+id/tv_word"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="monkey"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"
                        android:layout_gravity="center"/>

                    <!-- Word Type -->
                    <TextView
                        android:id="@+id/tv_word_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="noun"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:background="#4CAF50"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Question -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nghĩa của từ này là:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="16dp"/>

            <!-- Options -->
            <RadioGroup
                android:id="@+id/rg_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rb_option1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 1"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:background="@drawable/option_background"
                    android:layout_marginBottom="8dp"/>

                <RadioButton
                    android:id="@+id/rb_option2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 2"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:background="@drawable/option_background"
                    android:layout_marginBottom="8dp"/>

                <RadioButton
                    android:id="@+id/rb_option3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 3"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:background="@drawable/option_background"
                    android:layout_marginBottom="8dp"/>

                <RadioButton
                    android:id="@+id/rb_option4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 4"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:background="@drawable/option_background"/>
            </RadioGroup>

            <!-- Buttons -->
            <Button
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Câu tiếp theo"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#4A56E2"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"
                android:visibility="visible"/>

            <Button
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Nộp bài"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>